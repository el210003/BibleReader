{
  "name": "biblereader",
  "private": true,
  "version": "0.1.0",
  "description": "Multilingual Bible reader with highlight-to-speak TTS",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c blue,magenta \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dev:renderer": "vite",
    "build": "tsc -b && vite build",
    "start": "npm run build && electron .",
    "lint": "oxlint",
    "spike:scripture": "node spikes/01-scripture.mjs",
    "spike:tts": "node spikes/02-tts.mjs",
    "spike:highlight": "node spikes/03-highlight-plan.mjs",
    "smoke": "cross-env SMOKE=1 electron ."
  },
  "dependencies": {
    "msedge-tts": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  }
}
